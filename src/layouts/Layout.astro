---
import '@fontsource-variable/league-spartan';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content, routes, type Locale, type Page } from '../data/site';
interface Props { locale: Locale; page: Page; title?: string; noindex?: boolean; }
const { locale, page, title, noindex = false } = Astro.props;
const t = content[locale];
const pageTitle = `${title ?? t.titles[page]} | PAR—LE`;
const canonical = Astro.site ? new URL(routes[locale][page], Astro.site) : undefined;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F3F1EC" />
    <meta name="description" content={t.descriptions[page]} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {Astro.site && !noindex && <>
      <link rel="alternate" hreflang="pt-PT" href={new URL(routes.pt[page], Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(routes.en[page], Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(routes.pt[page], Astro.site)} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PAR—LE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t.descriptions[page]} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_GB'} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />}
  </head>
  <body class:list={[`page-${page}`, `locale-${locale}`]}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
