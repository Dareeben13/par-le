---
import { content, routes, type Locale } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = content[locale];
---
<section class="home-hero container">
  <div class="hero-copy">
    <p class="agency-label"><span class="status-dot" aria-hidden="true"></span>{t.agency}</p>
    <h1>{t.home.headline.map((line) => <span>{line}</span>)}</h1>
    <p class="hero-description">{t.home.introduction}</p>
    <a class="button" href={routes[locale].contact}>{t.talk}<Arrow diagonal /></a>
  </div>
  <figure class="hero-visual">
    <div class="hero-art"><img src="/images/gallery.webp" alt={t.home.imageAlt} width="708" height="876" fetchpriority="high" /><span class="speech-mark" aria-hidden="true"></span></div>
    <figcaption><span>{t.home.imageCaption}</span><span aria-hidden="true">↙</span></figcaption>
  </figure>
  <div class="hero-bottom"><span>{t.home.note}</span><a href="#intro" aria-label={t.more}><span aria-hidden="true">↓</span></a></div>
</section>

<section class="intro-section" id="intro"><div class="container intro-layout">
  <div class="intro-symbol" aria-hidden="true"><span class="speech-mark"></span></div>
  <div><h2>{t.home.aboutHeading}</h2><p>{t.home.aboutBody}</p><a class="text-link" href={routes[locale].about}>{t.more}<Arrow /></a></div>
</div></section>

<section class="section container home-services">
  <div class="section-heading"><h2 class="heading-lines">{t.home.servicesHeading}</h2><p>{t.home.servicesIntro}</p></div>
  <div class="service-links">{t.services.map((service, i) => <a href={`${routes[locale].services}#service-${i + 1}`}><h3>{service.title}</h3><span class="service-link-arrow"><Arrow diagonal /></span></a>)}</div>
</section>

<section class="home-team"><div class="container home-team-layout">
  <div class="team-preview">{t.team.founders.map((founder) => <figure><img src={`/images/${founder.image}.webp`} alt={founder.name} width="800" height="1067" loading="lazy" /><figcaption>{founder.name}</figcaption></figure>)}</div>
  <div class="team-copy"><h2 class="heading-lines">{t.home.teamHeading}</h2><p>{t.home.teamIntro}</p><a class="text-link" href={routes[locale].team}>{t.home.teamLink}<Arrow /></a></div>
</div></section>
