---
interface Props { name: 'instagram' | 'email' | 'linkedin' | 'tiktok'; }
const { name } = Astro.props;
const gradientId = `instagram-${crypto.randomUUID()}`;
---
<svg class:list={['contact-icon', `contact-icon-${name}`]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'instagram' ? <>
    <defs><linearGradient id={gradientId} x1="0" y1="1" x2="1" y2="0"><stop stop-color="#ffdc80" /><stop offset=".3" stop-color="#fcaf45" /><stop offset=".55" stop-color="#e1306c" /><stop offset=".8" stop-color="#c13584" /><stop offset="1" stop-color="#5851db" /></linearGradient></defs>
    <rect x="1" y="1" width="22" height="22" rx="6" fill={`url(#${gradientId})`} stroke="none" />
    <rect x="6" y="6" width="12" height="12" rx="3.5" stroke="white" />
    <circle cx="12" cy="12" r="3" stroke="white" />
    <circle cx="16" cy="8" r=".85" fill="white" stroke="none" />
  </> : name === 'linkedin' ? <>
    <rect x="1" y="1" width="22" height="22" rx="3" fill="#0a66c2" stroke="none" />
    <circle cx="6.5" cy="7" r="1.3" fill="white" stroke="none" />
    <path d="M6.5 10v8M11 18v-8m0 3c0-4 7-4 7 0v5" stroke="white" stroke-width="2.4" />
  </> : name === 'tiktok' ? <>
    <rect x="1" y="1" width="22" height="22" rx="5" fill="#111111" stroke="none" />
    <path d="M13 6v10a3 3 0 1 1-3-3m3-7c0 3 2 4 5 4" stroke="#25f4ee" stroke-width="2.4" transform="translate(-.7 .5)" />
    <path d="M13 6v10a3 3 0 1 1-3-3m3-7c0 3 2 4 5 4" stroke="#fe2c55" stroke-width="2.4" transform="translate(.7 -.3)" />
    <path d="M13 6v10a3 3 0 1 1-3-3m3-7c0 3 2 4 5 4" stroke="white" stroke-width="2" />
  </> : <>
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m4 7 8 6 8-6" />
  </>}
</svg>
